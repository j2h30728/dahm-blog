# PC에서 .env.local에 설정합니다. Obsidian vault 안의 blog 폴더를 지정합니다.
# 개인 절대 경로는 저장소나 배포 환경에 넣지 않습니다.
OBSIDIAN_BLOG_DIR=/absolute/path/to/Obsidian/blog

# 운영 도메인. 로컬 개발에서는 생략할 수 있습니다.
PUBLIC_SITE_URL=
# 로컬에서 운영 빌드를 검증할 때만 허용합니다.
# ALLOW_LOCAL_SITE_URL=true

# 선택: Vercel Production에서만 수집하는 GA4 측정 ID입니다.
PUBLIC_GA_MEASUREMENT_ID=

# 선택: 댓글은 기본 활성화됩니다. 끄려면 false를 설정합니다.
GISCUS_ENABLED=true

# 선택: publish:blog가 사용할 remote/branch. 현재 브랜치와 upstream이 일치해야 합니다.
BLOG_PUBLISH_REMOTE=origin
BLOG_PUBLISH_BRANCH=main

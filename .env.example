# 실제 값은 저장소 루트의 .env 또는 .env.local에 입력합니다.
# process.env > .env.local > .env 순서로 사용합니다.
NOTION_TOKEN=
NOTION_DATABASE_ID=308e8c228b6581a7ad3ac188b53210d0
NOTION_DATA_SOURCE_ID=308e8c22-8b65-81ce-b792-000b7eb2b8bf

# 배포 도메인을 입력합니다. 로컬 개발에서는 생략할 수 있습니다.
PUBLIC_SITE_URL=

# 이미지 동기화: off(기존 외부 URL), local(로컬 변환), s3(S3 + CloudFront)
# AWS 계정 연결 전 local 모드로 실제 변환과 확대 동작을 검증할 수 있습니다.
IMAGE_ASSETS_MODE=off
# s3 모드 필수. 개인 블로그 전용 리소스의 값을 입력합니다.
IMAGE_AWS_ACCOUNT_ID=
AWS_REGION=ap-northeast-2
IMAGE_S3_BUCKET=
IMAGE_CDN_BASE_URL=
# Vercel Production의 OIDC 업로더 역할. CloudFormation의 AwsRoleArn 출력입니다.
AWS_ROLE_ARN=
# VERCEL_OIDC_TOKEN은 Vercel 빌드에서 자동 제공하므로 직접 입력하지 않습니다.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN/AWS_PROFILE은 필요하지 않습니다.
# s3 모드는 OIDC만 허용합니다. PC에서는 IMAGE_ASSETS_MODE=local로 검증합니다.

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../lib/ui-classes';
---
<BaseLayout title="페이지를 찾을 수 없습니다">
  <h1 class={ui.pageTitle}>페이지를 찾을 수 없습니다.</h1>
  <p class={ui.pageSubtitle}>주소가 변경되었거나 공개되지 않은 기록입니다.</p>
  <a class="mt-6 inline-block underline" href="/">홈으로 돌아가기</a>
</BaseLayout>

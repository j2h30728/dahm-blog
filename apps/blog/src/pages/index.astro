---
import Archive from '../components/Archive.astro';
import { getPublishedPosts } from '../lib/posts';
import { siteConfig } from '../lib/site';
const posts = (await getPublishedPosts()).filter(post => post.kind === 'posts');
---
<Archive posts={posts} title="글" description={siteConfig.homeDescription} active="posts" searchTarget="/" postCategory="all" showCategory />

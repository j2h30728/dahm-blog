{
  "name": "dahm-blog-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "preinstall": "node scripts/check-env.mjs",
    "dev": "node scripts/dev.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "publish:blog": "node scripts/publish-blog.mjs",
    "test": "pnpm --filter @dahm-blog/content-sync test && pnpm --filter @dahm-blog/blog test && pnpm test:publish",
    "test:browser": "node scripts/test-browser.mjs",
    "test:integration": "node scripts/test-content-integration.mjs",
    "test:publish": "node --test scripts/test/publish-blog.test.mjs",
    "build:blog": "node scripts/prepare-content.mjs && pnpm --filter @dahm-blog/blog build",
    "build": "pnpm build:blog",
    "typecheck": "pnpm --filter @dahm-blog/blog typecheck"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@playwright/test": "^1.56.1",
    "typescript": "^5.8.3"
  },
  "volta": {
    "node": "24.17.0",
    "pnpm": "10.34.4"
  }
}

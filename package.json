{
  "name": "dahm-blog-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "preinstall": "node scripts/check-env.mjs",
    "dev": "pnpm sync:content && pnpm --filter @dahm-blog/blog dev",
    "sync:content": "pnpm --filter @dahm-blog/content-sync sync",
    "test": "pnpm --filter @dahm-blog/content-sync test && pnpm sync:content && pnpm --filter @dahm-blog/blog test",
    "build:blog": "pnpm sync:content && pnpm --filter @dahm-blog/blog build",
    "build": "pnpm --filter @dahm-blog/content-sync build && pnpm build:blog",
    "typecheck": "pnpm --filter @dahm-blog/content-sync typecheck && pnpm sync:content && pnpm --filter @dahm-blog/blog typecheck"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "next": "^16.2.9",
    "typescript": "^5.8.3"
  },
  "volta": {
    "node": "24.17.0",
    "pnpm": "10.34.4"
  }
}

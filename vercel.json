{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:blog",
  "outputDirectory": "apps/blog/dist",
  "framework": null,
  "redirects": [
    {
      "source": "/posts",
      "has": [{ "type": "query", "key": "category", "value": { "eq": "life" } }],
      "destination": "/life/",
      "permanent": true
    },
    {
      "source": "/posts/",
      "has": [{ "type": "query", "key": "category", "value": { "eq": "life" } }],
      "destination": "/life/",
      "permanent": true
    }
  ]
}
